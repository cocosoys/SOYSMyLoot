<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>soys</groupId>
    <artifactId>SOYSMyLoot</artifactId>
    <version>1.4.0</version>
    <packaging>jar</packaging>

    <name>SOYSMyLoot</name>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>dist/**</exclude>
                </excludes>
            </resource>
            <!-- 前端打包产物（含 gz 二进制）不做资源过滤，避免 MalformedInputException -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>dist/**</include>
                </includes>
            </resource>
        </resources>
    </build>

    <repositories>
        <!-- PlayerPoints -->
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>rosewooddev-repo</id>
            <url>https://repo.rosewooddev.io/repository/public/</url>
        </repository>
        <!-- PlaceholderAPI -->
        <repository>
            <id>placeholderapi-repo</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <!-- Spigot API -->
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- Vault (via jitpack) -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot 1.12.2 API（服务端提供） -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.12.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault (经济，服务端提供) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlayerPoints (点券，服务端提供) -->
        <!-- Source: https://mvnrepository.com/artifact/org.black_ixx/playerpoints -->
        <dependency>
            <groupId>org.black_ixx</groupId>
            <artifactId>playerpoints</artifactId>
            <version>2.1.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI (占位符，服务端提供) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!--
            SnakeYAML：用于配置校验器解析 YAML 节点树并标注行号（spigot-api 已传递依赖，
            此处显式声明 provided 以保证编译期可见，运行时复用服务端自带的 snakeyaml）。
        -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>1.33</version>
            <scope>provided</scope>
        </dependency>

        <!--
            JDBC 驱动说明：
            与 SOYSLinkTeam 保持一致，Spigot 1.12.2 服务端已内置 MySQL Connector/J 与 SQLite JDBC，
            因此统一使用 provided，不打包进插件，避免 jar 体积膨胀与驱动冲突。
            若服务端缺失驱动，插件会在启用对应后端时给出明确报错提示。
        -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.28</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.36.0.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- ================================================================
             SOYSHTTPOverMC（HTTP-over-MC 网关，1.4.1 core）+ MCERP（ERP 中控宿主）
             ================================================================
             依赖已通过 mvn install 安装到本地仓库，Maven 按 GAV 直接解析，无需
             systemPath。运行时由服务器提供（SOYSMyLoot 以 softdepend 引入），编译期
             仅用于解析注解式 API / 页面托管 / 鉴权门面，不打包进本插件。
             SOYSMyLoot 以 McerpExpansion 子类形态登记为 ERP 模块：
             端点自动挂 /api/plugins/<identifier>/* 前缀。
             ================================================================ -->
        <!-- MCERP：ERP 中控宿主（McerpExpansion / ErpRegistry / ErpMenus） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>MCERP</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- SOYSHTTPOverMC：注解式 API / 页面托管 / 鉴权 / 数据层运维门面（1.4.1 core） -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc-core</artifactId>
            <version>1.4.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- Lombok：编译期注解处理（ERP 模块日志 / VO），不打包 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>

        <!-- 单元测试（仅测试范围，不进入插件 jar） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
